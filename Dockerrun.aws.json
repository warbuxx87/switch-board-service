{
  "AWSEBDockerrunVersion": 2,
  "volumes": [{
      "name": "switch-board-service",
      "host": {
        "sourcePath": "."
      }
    },
    {
      "name": "switch_database",
      "host": {
        "sourcePath": "."
      }
    }
  ],
  "containerDefinitions": [{
      "name": "switch-board-service",
      "image": "alpine:3.9",
      "essential": true,
      "memory": 128,
      "portMappings": [{
        "hostPort": 80,
        "containerPort": 7020
      }],
      "mountPoints": [{
          "sourceVolume": "switch-board-service",
          "containerPath": ".",
          "readOnly": true
        },
        {
          "sourceVolume": "awseb-logs-switch-board-service",
          "containerPath": "/var/log/switch-board-service"
        }
      ]
    },
    {
      "name": "switch_database",
      "image": "mysql:5.7",
      "essential": true,
      "memory": 128,
      "portMappings": [{
        "hostPort": 3306,
        "containerPort": 3306
      }],
      "environment": [{
          "name": "MYSQL_USERNAME",
          "value": "switchuser"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "switchpassword"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "switchboarddb"
        }
      ],
      "links": [
        "switch-board-service"
      ],
      "mountPoints": [{
          "sourceVolume": "switch-board-service",
          "containerPath": ".",
          "readOnly": true
        },
        {
          "sourceVolume": "switch_database",
          "containerPath": "/Users/user/mnt/db_data:/mnt/db_data",
          "readOnly": true
        }
      ]
    }
  ]
}
